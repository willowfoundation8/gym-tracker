# Dependencies — regenerated by `npm install` from package.json + package-lock.json
node_modules/

# Build output — regenerated by `npm run build`
dist/

# Local wrangler dev state
.wrangler/

# Secrets — never commit.
# .dev.vars feeds `wrangler pages dev`, .env feeds Vite. Both hold API keys.
.dev.vars
.env
.env.local

# Local editor/tool config (machine-specific absolute paths)
.claude/

# macOS
.DS_Store
